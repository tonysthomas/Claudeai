# Skechers Sales Assistant — environment variable template
# Copy to `.env` and fill in real values. NEVER commit `.env`.
# Only VITE_-prefixed variables are exposed to the browser.

# --- Public (browser) ---
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_APP_ENV=development
# While using synthetic data, keep this true so prices/availability show demo labels.
VITE_DEMO_MODE=true

# --- Server / scripts only — NEVER ship these to the client ---
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PROJECT_REF=
SUPABASE_DB_URL=

# --- Phase 7 (grounded AI assist) — Edge Function only, never client ---
# ANTHROPIC_API_KEY=

# --- Optional ---
# VITE_SENTRY_DSN=
